# RIFFAT'S CLASSROOM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development

# -------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL or Local Docker PostgreSQL)
# -------------------------------------------------------------
# For Local Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riffats_classroom?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/riffats_classroom?schema=public"

# For Neon Serverless PostgreSQL (Production / Vercel):
# DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="riffats_classroom_dev_super_secret_jwt_key_at_least_32_chars_long!"

# Google OAuth (Optional in development, required for production "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -------------------------------------------------------------
# 3. STORAGE & MEDIA (Vercel Blob / Local Storage)
# -------------------------------------------------------------
# Driver options: "local" (saves to public/uploads) or "blob" (Vercel Blob)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# -------------------------------------------------------------
# 4. BACKGROUND JOBS & CRON
# -------------------------------------------------------------
# Bearer token for Vercel Cron triggers (/api/cron/daily-challenge)
CRON_SECRET="riffats_cron_secret_auth_token_2026"

# -------------------------------------------------------------
# 5. DEFAULT LOCALIZATION & TIMEZONE
# -------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Dhaka"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
